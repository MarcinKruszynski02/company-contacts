
<div class="contact-form-container">
  <div class="contact-form-card">

    <h1>Dodaj nowy kontakt</h1>
    <p class="form-description">
      Wprowadź dane do firmowej książki kontaktów.
    </p>

    <%= form_with model: @contact do |form| %>

      <% if @contact.errors.any? %>
        <div class="form-errors">
          <% @contact.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :name, "Imię i nazwisko" %>
        <%= form.text_field :name,
            placeholder: "np. Jan Kowalski",
            required: true %>
      </div>

      <div class="form-group">
        <%= form.label :phone, "Numer telefonu" %>
        <%= form.telephone_field :phone,
            placeholder: "np. 500 600 700",
            required: true %>
      </div>

      <div class="form-group">
        <%= form.label :category, "Kategoria" %>
        <%= form.text_field :category,
            placeholder: "np. IT, Serwis, Klient" %>
      </div>

      <%= form.submit "Zapisz kontakt",
          class: "submit-button" %>

    <% end %>

    <%= link_to "← Powrót do listy",
        contacts_path,
        class: "back-link" %>

  </div>
</div>
